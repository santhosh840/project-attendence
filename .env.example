# Application Settings
FLASK_APP=app.py
FLASK_ENV=production
SECRET_KEY=change-this-to-a-super-secret-key-123456789

# Database Configuration (MySQL / SQLite fallback)
# For MySQL on local/cloud: mysql+pymysql://username:password@localhost:3306/attendance_db
DB_TYPE=sqlite
DB_USER=root
DB_PASSWORD=rootpassword
DB_HOST=localhost
DB_PORT=3306
DB_NAME=attendance_db
DATABASE_URL=sqlite:///attendance.db

# Email Notification Settings (SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Facial Recognition & Liveness Settings
FACE_MATCH_THRESHOLD=0.55
DUPLICATE_ATTENDANCE_COOLDOWN_MINUTES=60
LIVENESS_CHECK_ENABLED=True
LAPLACIAN_VARIANCE_THRESHOLD=50.0

# Admin Default Credentials (Initial creation)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@attendance.com
ADMIN_PASSWORD=admin123
